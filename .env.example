# Default is live. Set to "demo" only for local UI work with seed data.
VITE_MARKET_DATA_MODE=live

# Finnhub free-tier key (server-side). Prefer FINNHUB_API_KEY so it is not
# bundled into the browser. VITE_FINNHUB_API_KEY is also accepted by the proxy.
FINNHUB_API_KEY=
# VITE_FINNHUB_API_KEY=

# Stage-1 Yahoo screener (server)
# SCAN_MIN_PRICE=5
# SCAN_MIN_AVG_VOL=750000
# SCAN_STAGE1_CAP=800
# SCAN_CACHE_STALE_MS=2700000
# SCAN_STAGE2_CONCURRENCY=3
# SCAN_STAGE2_GAP_MS=150
